body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
}

.navbar {
    background-color: #222;
    color: white;
    padding: 15px 50px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.navbar h2 {
    margin: 0;
}

.navbar a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    font-weight: bold;
}

.heading {
    text-align: center;
    padding: 25px;
    background-color: white;
}

.heading h1 {
    margin-bottom: 5px;
}

#loading {
    text-align: center;
    margin-top: 30px;
}

.products {
    width: 90%;
    margin: 25px auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
}

.card {
    background-color: white;
    padding: 15px;
    text-align: center;
    border-radius: 8px;
    box-shadow: 0 0 8px gray;
}

.card img {
    width: 140px;
    height: 140px;
    object-fit: contain;
}

.card h3 {
    font-size: 16px;
    min-height: 45px;
}

.price {
    color: green;
    font-weight: bold;
}

.card a {
    display: inline-block;
    margin: 8px;
    color: blue;
}

button {
    background-color: orange;
    border: none;
    padding: 9px 12px;
    cursor: pointer;
    border-radius: 5px;
    font-weight: bold;
}

.back {
    display: inline-block;
    margin: 25px 0 0 8%;
    color: blue;
    text-decoration: none;
    font-weight: bold;
}

.detail-box {
    width: 75%;
    margin: 25px auto;
    background-color: white;
    padding: 25px;
    display: flex;
    gap: 30px;
    border-radius: 8px;
    box-shadow: 0 0 8px gray;
}

.detail-box img {
    width: 280px;
    height: 280px;
    object-fit: contain;
}

.cart-heading {
    text-align: center;
    margin-top: 25px;
}

.cart-info {
    width: 85%;
    margin: 15px auto;
    background-color: white;
    padding: 12px 20px;
    border-radius: 8px;
    box-shadow: 0 0 6px gray;
}

.cart-page {
    width: 85%;
    margin: auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 25px;
}

.cart-item {
    background-color: white;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 8px;
    box-shadow: 0 0 6px gray;
    display: flex;
    gap: 15px;
    align-items: center;
}

.cart-item img {
    width: 90px;
    height: 90px;
    object-fit: contain;
}

.bill {
    background-color: white;
    padding: 20px;
    border-radius: 8px;
    height: fit-content;
    box-shadow: 0 0 6px gray;
}

.remove {
    background-color: tomato;
    color: white;
}

@media (max-width: 1000px) {
    .products {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 700px) {
    .products {
        grid-template-columns: 1fr;
    }

    .cart-page,
    .detail-box {
        display: block;
    }

    .navbar {
        padding: 15px;
    }
}